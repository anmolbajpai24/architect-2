# Optional. When unset, scripts use an in-process PGlite database (fresh each run).
# Supabase: use the pooler connection string.
DATABASE_URL=

# Only needed for --live (agents) or --judge (judge assertions).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional override for judge assertions (provider:model).
JUDGE_MODEL=anthropic:claude-opus-5-5

# Workspace UI (pnpm dev). Defaults: fixture models, judge off.
# ARCHITECT_MODEL_MODE=live
# ARCHITECT_JUDGE=live

# Change proposer (Architect). Unset = live when the model's API key is present, else the offline fixture
# proposer (only knows the scripted demo request).
# ARCHITECT_PROPOSER=live
# ARCHITECT_PROPOSER_MODEL=anthropic:claude-opus-5-5
