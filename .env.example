# Architect 2.0 — server configuration. Copy to .env.local (gitignored) for local work.
# Every variable is read on the server only (src/server/env.ts). Never prefix one with NEXT_PUBLIC_, and never commit
# real values. Placeholders below are examples, not working credentials. docs/DEPLOYMENT.md explains each setup.
#
#                         | Local demo (offline) | Local, real models    | Public deployment (Vercel)
#   ----------------------+----------------------+-----------------------+-------------------------------------------
#   DATABASE_URL          | leave empty (PGlite) | leave empty (PGlite)  | REQUIRED (Supabase pooled connection)
#   SUPABASE_URL/ANON_KEY | leave empty (no auth)| optional              | REQUIRED (otherwise every project is open)
#   ARCHITECT_PUBLIC_URL  | leave empty          | optional              | REQUIRED (OAuth redirect, PR + live links)
#   ANTHROPIC_API_KEY     | leave empty          | REQUIRED              | REQUIRED
#   *_MODE / PROPOSER     | leave unset          | live                  | live
#   ARCHITECT_GITHUB_*    | leave empty          | optional              | optional (only for "Ship to GitHub")
#
# With nothing set, Architect runs fully offline: in-process database, recorded fixture models, no accounts. The
# reference Laptop Advisor project reproduces the key demo exactly; creating a project from a brief needs a model.

# ---------------------------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------------------------

# Empty = in-process PGlite, created, migrated and seeded on every start and discarded when the server stops
# (local only). Set it to persist; for Supabase use the pooled connection string (transaction pooler, port 6543).
# A deployment (VERCEL set by the platform) without it is refused unless ARCHITECT_ALLOW_EPHEMERAL_DB=1.
DATABASE_URL=
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Accept a deployment with no DATABASE_URL (each instance keeps its own throwaway copy). Throwaway previews only.
# ARCHITECT_ALLOW_EPHEMERAL_DB=1

# ---------------------------------------------------------------------------------------------------------------
# Sign in with Google (Supabase Auth on the same Supabase project as DATABASE_URL)
#
# Both empty: no accounts. Every project, generated or reference, is open to anyone who can reach the server, which
# is fine for local work and the offline demo but not for a public deployment.
# Both set: a project created from a brief belongs to the Google account that created it and is owner-only. The
# reference example stays public to view; changing, running, resetting or shipping it needs any signed-in account.
# Google OAuth setup steps: docs/DEPLOYMENT.md §6a. The anon key is held server-side only.
# ---------------------------------------------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<supabase-anon-key>

# Where this deployment is reachable (no trailing slash). Used as the OAuth redirect base, so a proxy header can't
# rewrite where Google returns to, and for the links a shipped pull request carries back to the change and to the
# running project (/preview/<projectId>). Required in production; optional locally.
ARCHITECT_PUBLIC_URL=
# ARCHITECT_PUBLIC_URL=https://<your-deployment>.vercel.app

# ---------------------------------------------------------------------------------------------------------------
# Models
#
# Model names come from each agent's configuration and the variables below, never from the browser.
# A live mode without a usable key is reported (Environment panel, /api/health) and refuses the work; nothing
# silently falls back to the recorded fixtures.
# ---------------------------------------------------------------------------------------------------------------

# ANTHROPIC_API_KEY is needed for every default live model; OPENAI_API_KEY only for an agent or override that
# names an "openai:" model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-<your-key>

# Agent runtime. Unset/fixture: the deterministic fixture model (reference project only; a generated project has no
# recorded behavior and needs live). live: each AgentVersion's provider model, and judge assertions are scored.
# ARCHITECT_MODEL_MODE=live

# Change proposer, rule-change proposer and project planner. fixture: replays the scripted demo requests only.
# live: a real model drafts any change and plans projects from a brief.
# Unset = live whenever the proposer model's API key is present, fixture otherwise. Set it explicitly to be sure.
# ARCHITECT_PROPOSER=live

# Judge assertions without putting the agents on live models. Implied by ARCHITECT_MODEL_MODE=live. Unset = skipped.
# ARCHITECT_JUDGE=live

# Optional model overrides (provider:model). Both default to anthropic:claude-opus-5-5.
# ARCHITECT_PROPOSER_MODEL=anthropic:claude-opus-5-5
# JUDGE_MODEL=anthropic:claude-opus-5-5

# ---------------------------------------------------------------------------------------------------------------
# Ship to GitHub (optional; everything else works without it)
#
# Prototype credential: ONE server-wide fine-grained personal access token, limited to the repositories below, with
# Repository permissions → Contents: Read and write, Pull requests: Read and write. Every user who may ship ships to
# this same allowlist (the demo repository); there is no per-user GitHub connection in the prototype. Production
# replaces it with a GitHub App installation token per user/repository (docs/architecture.md).
# A shipped pull request records the verified state; merging it deploys nothing.
# ---------------------------------------------------------------------------------------------------------------

ARCHITECT_GITHUB_TOKEN=
# ARCHITECT_GITHUB_TOKEN=github_pat_<fine-grained-token>
# Comma-separated owner/name allowlist (each needs at least one commit on its default branch, e.g. a README).
ARCHITECT_GITHUB_REPOS=
# ARCHITECT_GITHUB_REPOS=<your-org>/<demo-repository>
# Optional: GitHub Enterprise Server API URL (default https://api.github.com).
# ARCHITECT_GITHUB_API_URL=https://<ghe-host>/api/v3

# ---------------------------------------------------------------------------------------------------------------
# Advanced
# ---------------------------------------------------------------------------------------------------------------

# Which code-defined project a request without ?project= opens. Default: laptop-advisor (the only one defined).
# ARCHITECT_PROJECT=laptop-advisor
